# Base de datos
DATABASE_URL=postgresql://user:pass@localhost:5432/parqueo_db
DIRECT_URL=postgresql://user:pass@localhost:5432/parqueo_db

# JWT — requeridos, no dejar vacíos
JWT_SECRET=
JWT_REFRESH_SECRET=

# Next.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Next.js asigna NODE_ENV automáticamente (no definirlo aquí).
PORT=3000

# ─── Laboratorios: acceso remoto ─────────────────────────────────────────────
# simulacion | guacamole | url  (guacamole/url requieren LAB_GUACAMOLE_BASE)
LAB_REMOTO_MODO=simulacion
LAB_GUACAMOLE_BASE=
# Plantilla: {base} {etiqueta} (ej. B5) {host} (ej. lab-pc-b5.uspg.local)
LAB_GUACAMOLE_URL_TEMPLATE={base}/#/client/PC-{etiqueta}
# true = nueva pestaña; false = iframe embebido en el portal
LAB_REMOTO_NUEVA_PESTANA=true

# ─── Laboratorios: tutor LLM (práctica inglés ING-LLM) ───────────────────────
# OpenAI, OpenRouter u otro API compatible con /v1/chat/completions
LAB_LLM_API_KEY=
LAB_LLM_MODEL=gpt-5.4-mini
# LAB_LLM_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=   # alternativa; usa https://openrouter.ai/api/v1 como base si aplica

# ─── Blockchain (parqueo + laboratorios — auditoría Polygon Amoy) ─────────────
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_PRIVATE_KEY=
# BLOCKCHAIN_CONTRACT_ADDRESS=

# ─── Login QR + Google institucional (@uspg.edu.gt) ───────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
